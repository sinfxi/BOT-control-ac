# Copy this file to ".env", fill it in, then run:  chmod 600 .env
# Get api_id / api_hash for YOUR OWN account at https://my.telegram.org -> API development tools
# NEVER commit .env and never share it.

TG_API_ID=
TG_API_HASH=

# Optional: saves you from typing the phone number at login (international format)
# TG_PHONE=+989121234567

# Optional paths (default: ~/.tgmanager/...)
# TG_SESSION_PATH=~/.tgmanager/account
# TG_DOWNLOAD_DIR=~/tgmanager_downloads
# TG_LOG_FILE=~/.tgmanager/tgmanager.log

# Optional tuning
# TG_LOG_LEVEL=INFO
# TG_FLOOD_SLEEP_THRESHOLD=60   # Telethon auto-sleeps for FloodWait shorter than this (seconds)
# TG_MAX_FLOOD_WAIT=300         # we refuse to wait longer than this for a FloodWait (seconds)
# TG_MAX_RETRIES=5
# TG_REQUEST_TIMEOUT=20
# TG_SEND_MIN_INTERVAL=1.0      # minimum seconds between write operations (anti-flood pacing)
